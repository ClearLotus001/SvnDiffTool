{
  "name": "svn-diff-tool",
  "version": "1.0.1",
  "description": "SvnDiffTool — TortoiseSVN external diff viewer for text and workbook files",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClearLotus001/SvnDiffTool.git"
  },
  "scripts": {
    "dev": "tsx scripts/dev-app.ts",
    "dev:app": "tsx scripts/dev-app.ts",
    "dev:electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:run": "tsx scripts/dev-electron-runner.ts",
    "generate:shiki-registry": "tsx scripts/generate-shiki-language-registry.ts",
    "lint": "npm run lint:eslint && npm run lint:exports",
    "lint:eslint": "eslint src electron scripts --max-warnings=0",
    "lint:exports": "tsx scripts/check-unused-exports.ts",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron && npm run build:rust",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:rust": "tsx scripts/build-rust.ts",
    "build:win:installer": "npm run build && tsx scripts/build-win-installer.ts",
    "build:win": "npm run build:win:installer",
    "build:win:release": "npm run build:win",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:electron && npm run typecheck:scripts && npm run typecheck:tests",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test:workbook": "tsx --test tests/*.test.ts",
    "test:workbook:search": "tsx --test tests/workbook-search-navigation.test.ts tests/workbook-selection-visual.test.ts",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "verify:install-upgrade": "tsx scripts/verify-install-upgrade.ts",
    "verify:single-instance-cache": "tsx scripts/verify-single-instance-cache.ts",
    "report:package-sizes": "tsx scripts/report-package-sizes.ts",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.svnexceldifftool.app",
    "productName": "SvnDiffTool",
    "artifactName": "${productName}-${version}.${ext}",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "executableName": "SvnDiffTool"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ClearLotus001",
        "repo": "SvnDiffTool",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "!**/node_modules/js-yaml/bin/**",
      "!**/node_modules/js-yaml/dist/**",
      "!**/node_modules/argparse/**",
      "!**/node_modules/fast-xml-parser/src/**",
      "!**/node_modules/fast-xml-parser/lib/*.min.js",
      "!**/node_modules/fast-xml-parser/lib/*.min.js.map",
      "!**/node_modules/fast-xml-parser/lib/*.d.cts",
      "!**/node_modules/fast-xml-builder/src/**",
      "!**/node_modules/fast-xml-builder/lib/*.min.js",
      "!**/node_modules/fast-xml-builder/lib/*.min.js.map",
      "!**/node_modules/fast-xml-builder/lib/*.d.cts",
      "!**/node_modules/path-expression-matcher/src/**",
      "!**/node_modules/path-expression-matcher/lib/*.min.js",
      "!**/node_modules/path-expression-matcher/lib/*.min.js.map",
      "!**/node_modules/path-expression-matcher/lib/*.d.cts",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "rust/target/release/svn_excel_parser.exe",
        "to": "bin/svn_excel_parser.exe"
      },
      {
        "from": "rust/target/release/svn_diff_launcher.exe",
        "to": "bin/svn_diff_launcher.exe"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerHeader": "installerHeader.bmp",
      "installerSidebar": "installerSidebar.bmp",
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@shikijs/core": "^4.0.2",
    "@shikijs/engine-javascript": "^4.0.2",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@shikijs/types": "^4.0.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fflate": "^0.8.2",
    "globals": "^17.4.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3",
    "zustand": "^5.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "fast-xml-parser": "^5.5.10"
  }
}
